{
  "name": "@vidx/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared API contracts (zod → OpenAPI 3.1) and Video Indexer insight parsers",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "^4.6.7",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "^2.11.0",
    "@types/node": "^26.6.5",
    "@vidx/config": "workspace:*",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "eslint": "^10.13.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
