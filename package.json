{
  "name": "serverless-video-transcription-and-indexer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "24.x",
    "pnpm": ">=11"
  },
  "prettier": "@vidx/config/prettier",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev dev:swa",
    "dev:swa": "swa start signal",
    "lint": "prettier --check . && turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "replay": "turbo run build --filter=@vidx/pipeline && pnpm --filter @vidx/pipeline replay",
    "smoke": "node scripts/smoke-test.ts",
    "diagnostics": "node scripts/download-diagnostics.ts",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@azure/cosmos": "^4.10.0",
    "@azure/identity": "^4.13.1",
    "@azure/static-web-apps-cli": "^2.0.10",
    "@azure/storage-blob": "^12.33.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@vidx/config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.9"
  }
}
