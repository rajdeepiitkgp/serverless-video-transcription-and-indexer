{
  "name": "@vidx/pipeline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Event-driven indexing pipeline: Event Grid triggers, Video Indexer callback, Discord notifier",
  "main": "dist/functions/*.js",
  "files": [
    "dist",
    "host.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "replay": "node dist/replay/cli.js"
  },
  "dependencies": {
    "@azure/cosmos": "^4.10.1",
    "@azure/eventgrid": "^5.12.0",
    "@azure/functions": "^4.16.5",
    "@azure/identity": "^4.13.3",
    "@azure/storage-blob": "^12.33.0",
    "@vidx/shared": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@vidx/config": "workspace:*",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/ui": "^5.0.1",
    "azurite": "^3.37.0",
    "eslint": "^10.10.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
